<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XrayUI.Views.AppSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:XrayUI.Helpers"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/AppSettingsExpander.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollView VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24"
                    Padding="0,0,16,24">

            <!-- ── Title ───────────────────────────────────────────────────── -->
            <TextBlock Text="软件设置"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <!-- ── 1. System & Startup (Top) ───────────────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock Text="系统与启动"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7E8;"
                                  FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="开机自启动"
                                       FontSize="14" />
                            <TextBlock Text="登录 Windows 时在后台静默启动本便携版"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{x:Bind ViewModel.IsStartupEnabled, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="0"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ── 2. Network & Port ──────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock Text="网络与端口"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel>
                        <!-- Local Port (Clean input without spin buttons) -->
                        <Grid Padding="16,12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE8B9;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="本地混合代理端口"
                                           FontSize="14" />
                                <TextBlock Text="Socks5 与 HTTP 混合监听端口 (1~65535)"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBox Text="{x:Bind ViewModel.LocalPortText, Mode=TwoWay}"
                                         MinWidth="80"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="🎲 随机端口"
                                        Command="{x:Bind ViewModel.GenerateRandomPortCommand}"
                                        ToolTipService.ToolTip="生成 10000 以上无冲突的随机端口"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Allow LAN Connections -->
                        <Grid Padding="16,12" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xEE77;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="允许来自局域网的连接"
                                           FontSize="14" />
                                <TextBlock Text="开启后局域网内的其他设备可通过本机 IP 和端口使用代理"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="2"
                                          IsOn="{x:Bind ViewModel.AllowLanConnections, Mode=TwoWay}"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <!-- Multi-Node Split Routing Mode Toggle -->
                        <Grid Padding="16,12" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE7F4;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="多节点分流模式"
                                           FontSize="14" />
                                <TextBlock Text="允许为不同节点分配独立本地端口，供第三方软件定向分流上网"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="2"
                                          IsOn="{x:Bind ViewModel.EnableMultiNodeRouting, Mode=TwoWay}"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── 3. Hotkeys ─────────────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock Text="快捷键设置"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="True"
                          Style="{StaticResource AppSettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid Padding="0,16,16,16" ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE92E;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="全局快捷键"
                                           FontSize="14" />
                                <TextBlock Text="自定义全局快捷键，随时随地快速切换与控制（支持乒乓键切换）"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <StackPanel>
                        <!-- 1. Toggle start/stop -->
                        <Grid MinHeight="52" Padding="58,10,16,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="启动/停止代理 (乒乓键)"
                                       FontSize="14"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    x:Name="ToggleHotkeyButton"
                                    MinWidth="150"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="HotkeyButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;"
                                              FontSize="12"
                                              Visibility="{x:Bind ViewModel.HotkeyToggleIsSet, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.HotkeyToggleDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 2. Show/Hide window (Restore/Minimize toggle) -->
                        <Grid MinHeight="52" Padding="58,10,16,10" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="显示/隐藏控制台窗口 (乒乓键)"
                                       FontSize="14"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    x:Name="RestoreHotkeyButton"
                                    MinWidth="150"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="HotkeyButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;"
                                              FontSize="12"
                                              Visibility="{x:Bind ViewModel.HotkeyRestoreIsSet, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.HotkeyRestoreDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 3. Toggle System Proxy -->
                        <Grid MinHeight="52" Padding="58,10,16,10" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="切换全局代理 (乒乓键)"
                                       FontSize="14"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    x:Name="SystemProxyHotkeyButton"
                                    MinWidth="150"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="HotkeyButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;"
                                              FontSize="12"
                                              Visibility="{x:Bind ViewModel.HotkeySystemProxyIsSet, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.HotkeySystemProxyDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 4. Toggle TUN Mode -->
                        <Grid MinHeight="52" Padding="58,10,16,10" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="切换 TUN 模式 (乒乓键)"
                                       FontSize="14"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    x:Name="TunHotkeyButton"
                                    MinWidth="150"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="HotkeyButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;"
                                              FontSize="12"
                                              Visibility="{x:Bind ViewModel.HotkeyTunIsSet, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.HotkeyTunDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 5. Toggle Routing Mode -->
                        <Grid MinHeight="52" Padding="58,10,16,10" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="切换路由模式 (乒乓键)"
                                       FontSize="14"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    x:Name="RoutingHotkeyButton"
                                    MinWidth="150"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="HotkeyButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;"
                                              FontSize="12"
                                              Visibility="{x:Bind ViewModel.HotkeyRoutingIsSet, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.HotkeyRoutingDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander>

                <InfoBar x:Name="HotkeySavedInfoBar"
                         IsOpen="False"
                         Severity="Informational"
                         IsClosable="True" />
            </StackPanel>

            <!-- ── 4. Data Management ─────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock Text="数据与备份管理"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel>
                        <!-- Open Data Folder -->
                        <Grid Padding="16,12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xED25;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="便携数据目录 (Data)"
                                           FontSize="14" />
                                <TextBlock Text="存放所有节点、订阅、核心配置与运行时数据，支持跨电脑直接复制"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="打开目录"
                                    Command="{x:Bind ViewModel.OpenDataFolderCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Import / Export Config -->
                        <Grid Padding="16,12" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE8F1;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="配置导入与导出"
                                           FontSize="14" />
                                <TextBlock Text="将当前的节点和路由规则备份到本地文件，或从已有文件中恢复"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button x:Name="ExportPresetButton"
                                        Padding="12,6"
                                        Content="导出"
                                        Click="ExportPresetButton_Click" />
                                <DropDownButton x:Name="ImportDropDownButton"
                                                Padding="12,6"
                                                Content="导入">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuFlyoutItem x:Name="ImportPresetMenuItem"
                                                            Text="恢复配置备份"
                                                            Click="ImportPresetButton_Click" />
                                            <MenuFlyoutItem x:Name="ImportClashMenuItem"
                                                            Text="导入 Clash 配置"
                                                            Click="ImportClashConfig_Click" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </Grid>

                        <!-- View Logs -->
                        <Grid Padding="16,12" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE7BA;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="运行日志"
                                           FontSize="14" />
                                <TextBlock Text="查看 Xray 核心运行输出与连接日志"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="查看日志"
                                    Command="{x:Bind ViewModel.ShowLogsCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="OperationInfoBar"
                         IsOpen="False"
                         Severity="Success"
                         IsClosable="True" />
            </StackPanel>

            <!-- ── 5. About & Version ─────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock Text="关于"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE946;"
                                  FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="XrayUI-Portable"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="高性能 WinUI 3 极简便携代理客户端"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ── Footer ──────────────────────────────────────────────────── -->
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.DoneCommand}"
                    MinWidth="88"
                    Content="完成" />

        </StackPanel>
    </ScrollView>
</UserControl>
