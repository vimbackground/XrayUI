<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="XrayUI.Views.ControlPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <Grid RowSpacing="6"
          Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Row 0: toolbar buttons ─────────────────────────────────── -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="4">

                <!-- 1. 模式调节 -->
                <Button x:Name="ModeSettingsButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        VerticalAlignment="Center"
                        Padding="8"
                        ToolTipService.ToolTip="模式调节">
                    <FontIcon Glyph="&#xF168;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutSubItem x:Uid="ControlPanel_ProxySettingsItem"
                                               Text="代理设置">
                                <RadioMenuFlyoutItem x:Uid="ControlPanel_GlobalProxyItem"
                                                     Text="全局代理"
                                                     GroupName="ProxyModeGroup"
                                                     IsChecked="{x:Bind ViewModel.IsGlobalProxyChecked, Mode=OneWay}"
                                                     IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                     Command="{x:Bind ViewModel.SetProxyModeCommand}"
                                                     CommandParameter="system" />
                                <RadioMenuFlyoutItem x:Uid="ControlPanel_NoProxyItem"
                                                     Text="不接管代理"
                                                     GroupName="ProxyModeGroup"
                                                     IsChecked="{x:Bind ViewModel.IsNoTakeoverChecked, Mode=OneWay}"
                                                     IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                     Command="{x:Bind ViewModel.SetProxyModeCommand}"
                                                     CommandParameter="manual" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Uid="ControlPanel_RoutingSettingsItem"
                                               Text="路由设置">
                                <RadioMenuFlyoutItem x:Uid="ControlPanel_RoutingSmartItem"
                                                     Text="智能分流"
                                                     GroupName="RoutingModeGroup"
                                                     IsChecked="{x:Bind ViewModel.IsSmartRoutingChecked, Mode=OneWay}"
                                                     IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                     Command="{x:Bind ViewModel.SetRoutingModeCommand}"
                                                     CommandParameter="smart" />
                                <RadioMenuFlyoutItem x:Uid="ControlPanel_RoutingGlobalItem"
                                                     Text="全局路由"
                                                     GroupName="RoutingModeGroup"
                                                     IsChecked="{x:Bind ViewModel.IsGlobalRoutingChecked, Mode=OneWay}"
                                                     IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                     Command="{x:Bind ViewModel.SetRoutingModeCommand}"
                                                     CommandParameter="global" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="ControlPanel_CustomRulesItem"
                                                Text="自定义规则..."
                                                IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.ShowCustomRulesCommand}" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="端口设置..."
                                            Command="{x:Bind ViewModel.EditLocalPortCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B9;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="ControlPanel_DnsItem"
                                            Text="DNS设置"
                                            IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ShowDnsSettingsCommand}" />
                            <MenuFlyoutItem x:Uid="ControlPanel_StartupItem"
                                            Text="开机启动"
                                            Command="{x:Bind ViewModel.OpenStartupSettingsCommand}"
                                            Icon="{x:Bind ViewModel.StartupMenuIcon, Mode=OneWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- 2. 个性化设置 -->
                <Button x:Name="PersonalizeButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        VerticalAlignment="Center"
                        Padding="8"
                        ToolTipService.ToolTip="个性化设置"
                        Command="{x:Bind ViewModel.ShowPersonalizeCommand}">
                    <FontIcon Glyph="&#xE771;" FontSize="16" />
                </Button>

                <!-- 3. 软件设置 -->
                <Button x:Name="AppSettingsButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        VerticalAlignment="Center"
                        Padding="8"
                        ToolTipService.ToolTip="软件设置"
                        Command="{x:Bind ViewModel.ShowAppSettingsCommand}">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>

            </StackPanel>
        </Grid>

        <!-- Row 1: main control area laid out horizontally in a single row -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="14">

                <!-- 1. 启动/停止按钮 -->
                <ToggleButton MinWidth="84"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Content="{x:Bind ViewModel.StartStopButtonContent, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.StartStopButtonChecked, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanStartStop, Mode=OneWay}"
                              Command="{x:Bind ViewModel.StartStopCommand}"
                              VerticalAlignment="Center" />

                <!-- 2. 全局代理开关 -->
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock x:Uid="ControlPanel_GlobalProxyLabel"
                               Text="全局代理"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsSystemProxyEnabled, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                  OnContent=""
                                  OffContent=""
                                  MinWidth="0"
                                  VerticalAlignment="Center" />
                </StackPanel>

                <!-- 3. TUN 模式开关 -->
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock x:Uid="ControlPanel_TunModeLabel"
                               Text="TUN 模式"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsTunMode, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsTunToggleEnabled, Mode=OneWay}"
                                  OnContent=""
                                  OffContent=""
                                  MinWidth="0"
                                  VerticalAlignment="Center" />
                </StackPanel>

                <!-- 4. 路由状态 -->
                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock x:Uid="ControlPanel_RoutingLbl"
                               Text="路由:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.RoutingModeText, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </Grid>

    </Grid>
</UserControl>

